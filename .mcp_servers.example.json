{
  "mcpServers": {
    "hackernews": {
      "command": "./mcp-servers/hackernews/hackernews"
    },
    "scheduler": {
      "command": "./mcp-servers/scheduler/scheduler"
    },
    "railway": {
      "command": "npx",
      "args": ["-y", "@railway/mcp-server"]
    },
    "pipeline": {
      "command": "./mcp-servers/pipeline/pipeline",
      "env": {
        "ANTHROPIC_API_KEY": "sk-ant-..."
      }
    }
  }
}
